{
  "name": "elseware",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "gen:wallpapers": "node scripts/generate-wallpapers.js",
    "gen:app-store": "node scripts/generate-app-store-screenshots.js",
    "gen:icons": "node scripts/generate-icon-variants.js",
    "gen:all": "npm run gen:wallpapers && npm run gen:app-store && npm run gen:icons",
    "render:founders": "node scripts/render-founders.js",
    "render:status": "node scripts/render-launch-status.js",
    "render:all": "npm run render:founders && npm run render:status",
    "status:weekly": "node scripts/render-launch-status.js",
    "sync:analytics": "node scripts/sync-analytics.js",
    "friday": "node scripts/sync-analytics.js && node scripts/render-launch-status.js",
    "prerelease": "npm run gen:all && npm run render:all",
    "preview": "node scripts/preview-server.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "expo": "~54.0.33",
    "expo-av": "~16.0.8",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-purchases": "^9.15.0",
    "react-native-purchases-ui": "^9.15.1",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
